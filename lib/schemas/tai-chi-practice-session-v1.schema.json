{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-cup-science:tai-chi:practice-session:1.0.0",
  "title": "Tai Chi practice session v1",
  "description": "A practitioner-local session record. It may reference skeletal traces but never contains raw media or derived assessment claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recordType", "schemaVersion", "sessionId", "startedAt", "endedAt", "sensitivity", "mediaRetention", "traceReferences"],
  "properties": {
    "recordType": { "const": "tai-chi-practice-session" },
    "schemaVersion": { "const": "1.0.0" },
    "sessionId": { "$ref": "#/$defs/identifier" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": { "classification": { "const": "sensitive-personal-practice-data" } }
    },
    "mediaRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsRawImage", "containsRawVideo", "containsRawAudio", "rawMediaRetention"],
      "properties": {
        "containsRawImage": { "const": false },
        "containsRawVideo": { "const": false },
        "containsRawAudio": { "const": false },
        "rawMediaRetention": { "const": "none" }
      }
    },
    "curriculumReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/versionedReference" },
      "uniqueItems": true
    },
    "traceReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/traceReference" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "admittedRelativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "versionedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "traceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "manifestPath"],
      "properties": {
        "traceId": { "$ref": "#/$defs/identifier" },
        "manifestPath": { "$ref": "#/$defs/admittedRelativePath" }
      }
    }
  }
}
